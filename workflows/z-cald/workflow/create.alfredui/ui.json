{
  "bundleid": "com.izsk.calendar",
  "log": {
    "level": "error",
    "internal": true
  },
  "variablesconfig": {
    "cal_query": {
      "src": "args[0]",
      "default": "",
      "scriptenv": true
    },
    "cal_day": {
      "default": "",
      "scriptenv": true
    },
    "actions_shortcut": {
      "src": "variable",
      "default": "⌘K"
    },
    "back_shortcut": {
      "src": "variable",
      "default": "⌘["
    },
    "cal_title": {
      "default": "",
      "scriptenv": true
    },
    "cal_calendar": {
      "default": "",
      "scriptenv": true
    },
    "cal_start_date": {
      "default": "",
      "scriptenv": true
    },
    "cal_start_time": {
      "default": "",
      "scriptenv": true
    },
    "cal_end_date": {
      "default": "",
      "scriptenv": true
    },
    "cal_end_time": {
      "default": "",
      "scriptenv": true
    },
    "cal_all_day": {
      "default": "",
      "scriptenv": true
    },
    "cal_location": {
      "default": "",
      "scriptenv": true
    },
    "cal_notes": {
      "default": "",
      "scriptenv": true
    },
    "cal_meeting_url": {
      "default": "",
      "scriptenv": true
    }
  },
  "window": {
    "title": "Create Event",
    "size": {
      "height": 560
    },
    "minsize": {
      "width": 620,
      "height": 480
    },
    "root": {
      "type": "view",
      "layout": "border",
      "events": [
        {
          "triggers": "launched",
          "action": [
            {
              "type": "script",
              "src": "../bin/cald",
              "args": [
                "create-init",
                "{var:cal_query}"
              ]
            },
            {
              "type": "script",
              "src": "../bin/cald",
              "args": [
                "create-refresh"
              ]
            },
            {
              "type": "script",
              "src": "../bin/cald",
              "args": [
                "create-pickers",
                "{value:calendarPicker.selected.value}"
              ]
            }
          ]
        },
        {
          "triggers": "preload",
          "action": {
            "type": "json",
            "src": {
              "window": {
                "resize": {
                  "width": 800
                }
              }
            }
          }
        }
      ],
      "shortcuts": [
        {
          "shortcut": "⌘R",
          "action": [
            {
              "type": "script",
              "src": "../bin/cald",
              "args": [
                "create-refresh"
              ]
            },
            {
              "type": "script",
              "src": "../bin/cald",
              "args": [
                "create-pickers",
                "{value:calendarPicker.selected.value}"
              ]
            }
          ]
        },
        {
          "shortcut": "{var:back_shortcut}",
          "action": {
            "type": "json",
            "src": {
              "finish": {
                "variables": {
                  "cal_out": "back"
                }
              }
            }
          }
        }
      ],
      "components": [
        {
          "type": "view",
          "layout": "border",
          "padding": 14,
          "spacing": 10,
          "constraints": {
            "region": "top"
          },
          "components": [
            {
              "id": "backButton",
              "type": "button",
              "text": "‹",
              "bordered": false,
              "events": [
                {
                  "triggers": "actioned",
                  "action": {
                    "type": "json",
                    "src": {
                      "finish": {
                        "variables": {
                          "cal_out": "back"
                        }
                      }
                    }
                  }
                }
              ],
              "font": {
                "size": 26
              },
              "tooltip": "Back to Calendar menu ⌘[",
              "constraints": {
                "region": "left",
                "position": "centre"
              }
            },
            {
              "id": "createTitle",
              "type": "label",
              "text": "Create Event",
              "font": {
                "size": 25,
                "weight": "light"
              },
              "constraints": {
                "region": "centre",
                "position": "centre",
                "stretch": "horizontal"
              }
            }
          ]
        },
        {
          "type": "view",
          "layout": "inline",
          "direction": "vertical",
          "spacing": 10,
          "constraints": {
            "region": "centre",
            "position": "top",
            "stretch": "horizontal",
            "insets": {
              "left": 20,
              "right": 20
            }
          },
          "components": [
            {
              "type": "view",
              "layout": "border",
              "spacing": 12,
              "components": [
                {
                  "id": "titleFieldCaption",
                  "type": "label",
                  "text": "Title",
                  "colour": "secondaryLabelColor",
                  "textalign": "right",
                  "constraints": {
                    "region": "left",
                    "position": "centre",
                    "size": {
                      "width": 85
                    }
                  }
                },
                {
                  "id": "titleField",
                  "type": "textfield",
                  "placeholder": "Team sync",
                  "focus": true,
                  "constraints": {
                    "region": "centre",
                    "stretch": "horizontal",
                    "position": "centre"
                  }
                }
              ]
            },
            {
              "type": "view",
              "layout": "border",
              "spacing": 12,
              "components": [
                {
                  "id": "calendarPickerCaption",
                  "type": "label",
                  "text": "Calendar",
                  "colour": "secondaryLabelColor",
                  "textalign": "right",
                  "constraints": {
                    "region": "left",
                    "position": "centre",
                    "size": {
                      "width": 85
                    }
                  }
                },
                {
                  "id": "calendarPicker",
                  "type": "picker",
                  "items": [
                    {
                      "text": "Loading calendars…",
                      "value": ""
                    }
                  ],
                  "constraints": {
                    "region": "centre",
                    "stretch": "horizontal",
                    "position": "centre"
                  }
                }
              ]
            },
            {
              "type": "view",
              "layout": "border",
              "spacing": 12,
              "components": [
                {
                  "id": "startLineCaption",
                  "type": "label",
                  "text": "Starts",
                  "colour": "secondaryLabelColor",
                  "textalign": "right",
                  "constraints": {
                    "region": "left",
                    "position": "centre",
                    "size": {
                      "width": 85
                    }
                  }
                },
                {
                  "id": "startLine",
                  "type": "view",
                  "layout": "border",
                  "spacing": 10,
                  "components": [
                    {
                      "id": "startDate",
                      "type": "textfield",
                      "placeholder": "YYYY-MM-DD",
                      "constraints": {
                        "region": "centre"
                      }
                    },
                    {
                      "id": "startTime",
                      "type": "textfield",
                      "placeholder": "HH:MM",
                      "constraints": {
                        "region": "right",
                        "size": {
                          "width": 100
                        }
                      }
                    }
                  ],
                  "constraints": {
                    "region": "centre",
                    "stretch": "horizontal",
                    "position": "centre"
                  }
                }
              ]
            },
            {
              "type": "view",
              "layout": "border",
              "spacing": 12,
              "components": [
                {
                  "id": "endLineCaption",
                  "type": "label",
                  "text": "Ends",
                  "colour": "secondaryLabelColor",
                  "textalign": "right",
                  "constraints": {
                    "region": "left",
                    "position": "centre",
                    "size": {
                      "width": 85
                    }
                  }
                },
                {
                  "id": "endLine",
                  "type": "view",
                  "layout": "border",
                  "spacing": 10,
                  "components": [
                    {
                      "id": "endDate",
                      "type": "textfield",
                      "placeholder": "YYYY-MM-DD",
                      "constraints": {
                        "region": "centre"
                      }
                    },
                    {
                      "id": "endTime",
                      "type": "textfield",
                      "placeholder": "HH:MM",
                      "constraints": {
                        "region": "right",
                        "size": {
                          "width": 100
                        }
                      }
                    }
                  ],
                  "constraints": {
                    "region": "centre",
                    "stretch": "horizontal",
                    "position": "centre"
                  }
                }
              ]
            },
            {
              "type": "view",
              "layout": "border",
              "spacing": 12,
              "components": [
                {
                  "id": "allDayCaption",
                  "type": "label",
                  "text": "",
                  "colour": "secondaryLabelColor",
                  "textalign": "right",
                  "constraints": {
                    "region": "left",
                    "position": "centre",
                    "size": {
                      "width": 85
                    }
                  }
                },
                {
                  "id": "allDay",
                  "type": "checkbox",
                  "text": "All day (end date is the last day included)",
                  "checked": false,
                  "events": [
                    {
                      "triggers": "changed",
                      "action": {
                        "type": "script",
                        "src": "../bin/cald",
                        "args": [
                          "create-all-day",
                          "{value:self.checked}"
                        ]
                      }
                    }
                  ],
                  "constraints": {
                    "region": "centre",
                    "stretch": "horizontal",
                    "position": "centre"
                  }
                }
              ]
            },
            {
              "type": "view",
              "layout": "border",
              "spacing": 12,
              "components": [
                {
                  "id": "locationFieldCaption",
                  "type": "label",
                  "text": "Location",
                  "colour": "secondaryLabelColor",
                  "textalign": "right",
                  "constraints": {
                    "region": "left",
                    "position": "centre",
                    "size": {
                      "width": 85
                    }
                  }
                },
                {
                  "id": "locationField",
                  "type": "textfield",
                  "placeholder": "Optional location",
                  "constraints": {
                    "region": "centre",
                    "stretch": "horizontal",
                    "position": "centre"
                  }
                }
              ]
            },
            {
              "type": "view",
              "layout": "border",
              "spacing": 12,
              "components": [
                {
                  "id": "meetingFieldCaption",
                  "type": "label",
                  "text": "Meeting",
                  "colour": "secondaryLabelColor",
                  "textalign": "right",
                  "constraints": {
                    "region": "left",
                    "position": "centre",
                    "size": {
                      "width": 85
                    }
                  }
                },
                {
                  "id": "meetingField",
                  "type": "textfield",
                  "placeholder": "Paste a Google Meet, Zoom, Teams or Webex link",
                  "constraints": {
                    "region": "centre",
                    "stretch": "horizontal",
                    "position": "centre"
                  }
                }
              ]
            },
            {
              "type": "view",
              "layout": "border",
              "spacing": 12,
              "components": [
                {
                  "id": "notesFieldCaption",
                  "type": "label",
                  "text": "Notes",
                  "colour": "secondaryLabelColor",
                  "textalign": "right",
                  "constraints": {
                    "region": "left",
                    "position": "centre",
                    "size": {
                      "width": 85
                    }
                  }
                },
                {
                  "id": "notesField",
                  "type": "textfield",
                  "placeholder": "Optional notes",
                  "multiline": true,
                  "constraints": {
                    "region": "centre",
                    "stretch": "horizontal",
                    "position": "centre"
                  }
                }
              ]
            },
            {
              "id": "timezoneLabel",
              "type": "label",
              "text": "",
              "colour": "secondaryLabelColor",
              "font": {
                "size": 11
              }
            }
          ]
        },
        {
          "type": "view",
          "layout": "stack",
          "constraints": {
            "region": "bottom"
          },
          "components": [
            {
              "type": "view",
              "layout": "border",
              "padding": 14,
              "background": {
                "dark": "#00000033",
                "light": "#0000000d"
              },
              "components": [
                {
                  "id": "statusLabel",
                  "type": "label",
                  "text": "Loading…",
                  "colour": "secondaryLabelColor",
                  "font": {
                    "size": 11.5
                  },
                  "constraints": {
                    "region": "centre",
                    "position": "centre",
                    "stretch": "horizontal"
                  }
                },
                {
                  "type": "view",
                  "layout": "inline",
                  "spacing": 10,
                  "constraints": {
                    "region": "right",
                    "position": "centre"
                  },
                  "components": [
                    {
                      "id": "accessButton",
                      "type": "button",
                      "text": "Allow Access",
                      "bordered": false,
                      "events": [
                        {
                          "triggers": "actioned",
                          "action": {
                            "type": "script",
                            "src": "../bin/cald",
                            "args": [
                              "authorize"
                            ],
                            "async": true
                          }
                        }
                      ],
                      "tooltip": "Request full calendar access",
                      "hidden": true,
                      "constraints": {
                        "size": {
                          "width": 0,
                          "height": 0
                        }
                      }
                    },
                    {
                      "id": "createButton",
                      "type": "button",
                      "text": "Create Event  ⌘↩",
                      "bordered": false,
                      "events": [
                        {
                          "triggers": "actioned",
                          "action": [
                            {
                              "type": "json",
                              "src": {
                                "update": {
                                  "ids": {
                                    "createButton": {
                                      "enabled": false
                                    },
                                    "statusLabel": {
                                      "text": "Saving event…"
                                    }
                                  }
                                }
                              },
                              "variables": {
                                "cal_title": "{value:titleField.text}",
                                "cal_calendar": "{value:calendarPicker.selected.value}",
                                "cal_start_date": "{value:startDate.text}",
                                "cal_start_time": "{value:startTime.text}",
                                "cal_end_date": "{value:endDate.text}",
                                "cal_end_time": "{value:endTime.text}",
                                "cal_all_day": "{value:allDay.checked}",
                                "cal_location": "{value:locationField.text}",
                                "cal_notes": "{value:notesField.text}",
                                "cal_meeting_url": "{value:meetingField.text}"
                              }
                            },
                            {
                              "type": "script",
                              "src": "../bin/cald",
                              "args": [
                                "create-save"
                              ],
                              "async": true
                            }
                          ]
                        }
                      ],
                      "enabled": false,
                      "shortcut": "⌘↩"
                    }
                  ]
                }
              ]
            },
            {
              "id": "privacyKey",
              "type": "button",
              "text": "",
              "bordered": false,
              "events": [
                {
                  "triggers": "actioned",
                  "action": {
                    "type": "json",
                    "src": {
                      "open": {
                        "type": "url",
                        "src": "x-apple.systempreferences:com.apple.preference.security?Privacy_Calendars"
                      }
                    }
                  }
                }
              ],
              "shortcut": "⇧⌘,",
              "opacity": 0,
              "constraints": {
                "size": {
                  "width": 0,
                  "height": 0
                }
              }
            },
            {
              "id": "refreshCalendarsKey",
              "type": "button",
              "text": "",
              "bordered": false,
              "events": [
                {
                  "triggers": "actioned",
                  "action": [
                    {
                      "type": "script",
                      "src": "../bin/cald",
                      "args": [
                        "create-refresh"
                      ]
                    },
                    {
                      "type": "script",
                      "src": "../bin/cald",
                      "args": [
                        "create-pickers",
                        "{value:calendarPicker.selected.value}"
                      ]
                    }
                  ]
                }
              ],
              "shortcut": "⇧⌘R",
              "opacity": 0,
              "constraints": {
                "size": {
                  "width": 0,
                  "height": 0
                }
              }
            }
          ]
        }
      ]
    }
  }
}
