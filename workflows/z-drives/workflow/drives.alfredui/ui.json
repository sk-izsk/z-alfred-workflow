{
  "bundleid": "com.izsk.drives",
  "variablesconfig": {
    "swiss_return": {
      "default": ""
    },
    "drives_session": {
      "default": "",
      "scriptenv": true
    },
    "drives_query": {
      "src": "args[0]",
      "default": "",
      "scriptenv": true
    },
    "back_shortcut": {
      "src": "variable",
      "default": "⌃⌥⇧⌘B"
    },
    "back_label": {
      "default": "Hyper+B"
    },
    "actions_label": {
      "default": "⌘K"
    },
    "actions_shortcut": {
      "src": "variable",
      "default": "⌘K"
    }
  },
  "window": {
    "title": "Drives",
    "size": {
      "width": 780,
      "height": 540
    },
    "minsize": {
      "width": 560,
      "height": 380
    },
    "root": {
      "id": "root",
      "type": "view",
      "layout": "border",
      "events": [
        {
          "triggers": "launched",
          "action": [
            {
              "type": "script",
              "src": "../bin/drives",
              "args": [
                "ui-profile",
                "initialBack"
              ],
              "async": false
            },
            {
              "type": "script",
              "src": "../bin/drives",
              "args": [
                "prepare-origin",
                "{var:drives_session}"
              ],
              "async": false
            },
            {
              "type": "script",
              "src": "../bin/drives",
              "args": [
                "launch",
                "{var:drives_session}"
              ],
              "async": true
            }
          ]
        }
      ],
      "shortcuts": [
        {
          "shortcut": "↑",
          "action": {
            "type": "function",
            "src": "items",
            "args": "selectprevious"
          }
        },
        {
          "shortcut": "↓",
          "action": {
            "type": "function",
            "src": "items",
            "args": "selectnext"
          }
        },
        {
          "shortcut": "{var:actions_shortcut}",
          "action": {
            "type": "script",
            "src": "../bin/drives",
            "args": [
              "menu",
              "{var:drives_session}",
              "{value:items.selected.uid}"
            ],
            "async": true
          }
        },
        {
          "shortcut": "⌘R",
          "action": {
            "type": "script",
            "src": "../bin/drives",
            "args": [
              "refresh",
              "{var:drives_session}"
            ],
            "async": true
          }
        },
        {
          "shortcut": "⌘O",
          "action": {
            "type": "script",
            "src": "../bin/drives",
            "args": [
              "reveal",
              "{var:drives_session}",
              "{value:items.selected.uid}"
            ],
            "async": false
          }
        },
        {
          "shortcut": "⌘C",
          "action": {
            "type": "script",
            "src": "../bin/drives",
            "args": [
              "copy",
              "{var:drives_session}",
              "{value:items.selected.uid}"
            ],
            "async": false
          }
        }
      ],
      "components": [
        {
          "id": "statusLabel",
          "type": "label",
          "text": "Loading Drives…",
          "constraints": {
            "region": "centre",
            "position": "centre"
          }
        },
        {
          "id": "initialBack",
          "type": "button",
          "text": "Back  {var:back_label}",
          "shortcut": "{var:back_shortcut}",
          "bordered": false,
          "constraints": {
            "region": "bottom",
            "position": "right",
            "insets": {
              "right": 12,
              "bottom": 12
            }
          },
          "events": [
            {
              "triggers": "actioned",
              "action": {
                "type": "json",
                "src": {
                  "finish": {
                    "variables": {
                      "drives_out": "back",
                      "swiss_return": "{var:swiss_return}"
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    }
  }
}
