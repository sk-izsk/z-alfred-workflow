                            "weight": "bold",
                            "monospaced": "digits"
                          },
                          "linebreak": "truncatetail",
                          "constraints": {
                            "size": {
                              "width": 46
                            }
                          }
                        }
                      ]
                    },
                    {
                      "id": "stext",
                      "type": "label",
                      "text": "",
                      "font": {
                        "size": 13
                      },
                      "linebreak": "truncatetail",
                      "constraints": {
                        "region": "centre",
                        "position": "left",
                        "stretch": "horizontal"
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "id": "mapBox",
          "type": "view",
          "layout": "stack",
          "cornerradius": 12,
          "cliptobounds": true,
          "constraints": {
            "region": "centre"
          },
          "components": [
            {
              "id": "map",
              "type": "webkitview",
              "text": "<html><body style='background:transparent'></body></html>",
              "openlinksexternally": "^https?:",
              "constraints": {
                "size": {
                  "width": 799,
                  "height": 620
                }
              },
              "events": [
                {
                  "triggers": "changed",
                  "action": {
                    "type": "script",
                    "src": "../bin/zmap",
                    "args": [
                      "pick",
                      "{value:map.src}"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "footer",
          "type": "view",
          "layout": "border",
          "spacing": 12,
          "constraints": {
            "region": "bottom"
          },
          "components": [
            {
              "id": "statusLabel",
              "type": "label",
              "text": "",
              "colour": "secondaryLabelColor",
              "font": {
                "size": 12.5
              },
              "linebreak": "truncatetail",
              "constraints": {
                "region": "centre",
                "position": "left",
                "stretch": "horizontal"
              }
            },
            {
              "id": "footerButtons",
              "type": "view",
              "layout": "inline",
              "spacing": 12,
              "constraints": {
                "region": "right"
              },
              "components": [
                {
                  "id": "footerBack",
                  "type": "button",
                  "text": "Back  {var:back_label}",
                  "bordered": false,
                  "events": [
                    {
                      "triggers": "actioned",
                      "action": {
                        "type": "json",
                        "src": {
                          "finish": {
                            "variables": {
                              "map_out": "back"
                            }
                          }
                        }
                      }
                    }
                  ],
                  "shortcut": "{var:back_shortcut}"
                },
                {
                  "id": "routeButton",
                  "type": "button",
                  "text": "Route  ↩",
                  "bordered": false,
                  "events": [
                    {
                      "triggers": "actioned",
                      "action": [
                        {
                          "type": "script",
                          "src": "../bin/zmap",
                          "args": [
                            "enter",
                            "{value:von.text}",
                            "{value:nach.text}",
                            "{value:via0.text}",
                            "{value:via1.text}",
                            "{value:via2.text}"
                          ]
                        },
                        {
                          "type": "script",
                          "src": "../bin/zmap",
                          "args": [
                            "route"
                          ],
                          "async": true
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "actionsButton",
                  "type": "button",
                  "text": "Actions  {var:actions_label}",
                  "bordered": false,
                  "events": [
                    {
                      "triggers": "actioned",
                      "action": {
                        "type": "script",
                        "src": "../bin/zmap",
                        "args": [
                          "menu",
                          "{value:von.text}",
                          "{value:nach.text}",
                          "{value:via0.text}",
                          "{value:via1.text}",
                          "{value:via2.text}"
                        ]
                      }
                    }
                  ]
                },
                {
                  "id": "removeStopKey",
                  "type": "button",
                  "text": "",
                  "bordered": false,
                  "events": [
                    {
                      "triggers": "actioned",
                      "action": {
                        "type": "script",
                        "src": "../bin/zmap",
                        "args": [
                          "remove-stop",
                          "{value:von.text}",
                          "{value:nach.text}",
                          "{value:via0.text}",
                          "{value:via1.text}",
                          "{value:via2.text}"
                        ]
                      }
                    }
                  ],
                  "shortcut": "⇧⌘U",
                  "opacity": 0,
                  "constraints": {
                    "size": {
                      "width": 0,
                      "height": 0
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
