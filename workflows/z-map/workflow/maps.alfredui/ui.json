            "type": "script",
            "src": "../bin/zmap",
            "args": [
              "suggest-move",
              "{value:von.text}",
              "{value:nach.text}",
              "{value:via0.text}",
              "{value:via1.text}",
              "{value:via2.text}",
              "1"
            ]
