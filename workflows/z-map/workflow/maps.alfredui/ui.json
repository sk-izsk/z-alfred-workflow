            },
            {
              "type": "script",
              "src": "../bin/zmap",
              "args": [
                "route"
              ],
              "async": true
            }
          ]
        },
        {
          "shortcut": "⌘U",
          "action": {
            "type": "script",
            "src": "../bin/zmap",
            "args": [
              "add-stop",
              "{value:von.text}",
              "{value:nach.text}",
              "{value:via0.text}",
              "{value:via1.text}",
              "{value:via2.text}"
            ]
          }
        },
        {
          "shortcut": "↓",
