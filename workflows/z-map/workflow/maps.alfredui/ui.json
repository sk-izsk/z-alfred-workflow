{
  "bundleid": "com.izsk.map",
  "log": {
    "level": "error",
    "internal": true
  },
  "variablesconfig": {
    "map_query": {
      "src": "args[0]",
      "default": ""
    },
    "actions_shortcut": {
      "src": "variable",
      "default": "⌘K"
    },
    "back_shortcut": {
      "src": "variable",
      "default": "⌃⌥⇧⌘B"
    },
    "back_label": {
      "default": "Hyper+B"
    },
    "actions_label": {
      "default": "⌘K"
    }
  },
  "window": {
    "title": "Maps",
    "size": {
      "width": 1180
    },
    "minsize": {
      "width": 560,
      "height": 400
    },
    "root": {
      "id": "root",
      "type": "view",
      "layout": "border",
      "padding": 12,
      "spacing": 12,
      "events": [
        {
          "triggers": "preload",
          "action": {
            "type": "json",
            "src": {
              "window": {
                "resize": {
                  "width": 1180
                }
              }
            }
          }
        },
        {
          "triggers": "launched",
          "action": [
            {
              "type": "script",
              "src": "../bin/zmap",
              "args": [
                "ui-profile",
                "footerBack"
              ],
              "async": false
            },
            {
              "type": "script",
              "src": "../bin/zmap",
              "args": [
                "launch",
                "{var:map_query}"
              ]
            },
            {
              "type": "script",
              "src": "../bin/zmap",
              "args": [
                "route"
              ],
              "async": true
            }
          ]
        }
      ],
      "shortcuts": [
        {
          "shortcut": "{var:actions_shortcut}",
          "action": {
            "type": "script",
            "src": "../bin/zmap",
            "args": [
              "menu",
              "{value:von.text}",
              "{value:nach.text}",
              "{value:via0.text}",
              "{value:via1.text}",
              "{value:via2.text}"
            ]
          }
        },
        {
          "shortcut": "⌘O",
          "action": {
            "type": "script",
            "src": "../bin/zmap",
            "args": [
              "open",
              "{value:von.text}",
              "{value:nach.text}",
              "{value:via0.text}",
              "{value:via1.text}",
              "{value:via2.text}"
            ]
          }
        },
        {
          "shortcut": "⌘T",
          "action": [
            {
              "type": "script",
              "src": "../bin/zmap",
              "args": [
                "swap",
                "{value:von.text}",
                "{value:nach.text}",
                "{value:via0.text}",
                "{value:via1.text}",
                "{value:via2.text}"
