{
  "bundleid": "com.izsk.brew",
  "log": {
    "level": "error",
    "internal": true
  },
  "variablesconfig": {
    "brew_plan": {
      "default": "",
      "scriptenv": true
    },
    "brew_tap": {
      "default": "",
      "scriptenv": true
    },
    "brew_query": {
      "src": "args[0]",
      "default": "",
      "scriptenv": true
    },
    "actions_shortcut": {
      "src": "variable",
      "default": "⌘K"
    },
    "back_shortcut": {
      "src": "variable",
      "default": "⌘["
    },
    "brew_window": {
      "default": "",
      "scriptenv": true
    }
  },
  "window": {
    "title": "Homebrew Maintenance",
    "size": {
      "height": 580
    },
    "minsize": {
      "width": 620,
      "height": 420
    },
    "root": {
      "type": "view",
      "layout": "border",
      "events": [
        {
          "triggers": "launched",
          "action": {
            "type": "script",
            "src": "../bin/brw",
            "args": [
              "load",
              "maintenance"
            ],
            "async": true
          }
        },
        {
          "triggers": "preload",
          "action": {
            "type": "json",
            "src": {
              "window": {
                "resize": {
                  "width": 900
                }
              }
            }
          }
        }
      ],
      "shortcuts": [
        {
          "shortcut": "⌘R",
          "action": {
            "type": "script",
            "src": "../bin/brw",
            "args": [
              "load",
              "maintenance",
              "refresh"
            ],
            "async": true
          }
        },
        {
          "shortcut": "{var:actions_shortcut}",
          "action": {
            "type": "script",
            "src": "../bin/brw",
            "args": [
              "report-menu"
            ]
          }
        },
        {
          "shortcut": "{var:back_shortcut}",
          "action": {
            "type": "json",
            "src": {
              "finish": {
                "variables": {
                  "brew_out": "back"
                }
              }
            }
          }
        }
      ],
      "components": [
        {
          "type": "view",
          "layout": "border",
          "padding": 14,
          "spacing": 10,
          "constraints": {
            "region": "top"
          },
          "components": [
            {
              "id": "backButton",
              "type": "button",
              "text": "‹",
              "bordered": false,
              "events": [
                {
                  "triggers": "actioned",
                  "action": {
                    "type": "json",
                    "src": {
                      "finish": {
                        "variables": {
                          "brew_out": "back"
                        }
                      }
                    }
                  }
                }
              ],
              "font": {
                "size": 26
              },
              "tooltip": "Back to Brew menu ⌘[",
              "constraints": {
                "region": "left",
                "position": "centre"
              }
            },
            {
              "id": "reportTitle",
              "type": "label",
              "text": "Homebrew Maintenance",
              "font": {
                "size": 23,
                "weight": "medium"
              },
              "constraints": {
                "region": "centre",
                "position": "centre",
                "stretch": "horizontal"
              }
            }
          ]
        },
        {
          "id": "reportText",
          "type": "textarea",
          "text": "Loading…",
          "background": null,
          "editable": false,
          "selectable": true,
          "font": {
            "size": 13
          },
          "colour": "labelColor",
          "constraints": {
            "region": "centre",
            "insets": {
              "left": 20,
              "right": 20,
              "top": 8,
              "bottom": 12
            }
          }
        },
        {
          "type": "view",
          "layout": "stack",
          "constraints": {
            "region": "bottom"
          },
          "components": [
            {
              "type": "view",
              "layout": "border",
              "padding": 14,
              "background": {
                "dark": "#00000033",
                "light": "#0000000d"
              },
              "components": [
                {
                  "type": "view",
                  "layout": "border",
                  "spacing": 7,
                  "constraints": {
                    "region": "centre",
                    "stretch": "horizontal"
                  },
                  "components": [
                    {
                      "type": "imageview",
                      "image": {
                        "type": "file",
                        "src": "../icon.png",
                        "size": {
                          "width": 15,
                          "height": 15
                        }
                      },
                      "constraints": {
                        "region": "left",
                        "position": "centre"
                      }
                    },
                    {
                      "id": "statusLabel",
                      "type": "label",
                      "text": "Loading…",
                      "colour": "secondaryLabelColor",
                      "font": {
                        "size": 11.5
                      },
                      "constraints": {
                        "region": "centre",
                        "position": "centre",
                        "stretch": "horizontal"
                      }
                    }
                  ]
                },
                {
                  "type": "view",
                  "layout": "inline",
                  "spacing": 10,
                  "constraints": {
                    "region": "right",
                    "position": "centre"
                  },
                  "components": [
                    {
                      "id": "reviewAction",
                      "type": "button",
                      "text": "Review Action",
                      "bordered": false,
                      "events": [
                        {
                          "triggers": "actioned",
                          "action": {
                            "type": "script",
                            "src": "../bin/brw",
                            "args": [
                              "maintenance-action"
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "id": "actionsButton",
                      "type": "button",
                      "text": "Actions  {var:actions_shortcut}",
                      "bordered": false,
                      "events": [
                        {
                          "triggers": "actioned",
                          "action": {
                            "type": "script",
                            "src": "../bin/brw",
                            "args": [
                              "report-menu"
                            ]
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
