{
  "bundleid": "com.izsk.weather",
  "log": {
    "level": "error",
    "internal": true
  },
  "variablesconfig": {
    "swiss_return": {
      "default": ""
    },
    "weather_session": {
      "default": "",
      "scriptenv": true
    },
    "weather_query": {
      "src": "args[0]",
      "default": "",
      "scriptenv": true
    },
    "actions_shortcut": {
      "src": "variable",
      "default": "⌘K"
    },
    "back_shortcut": {
      "src": "variable",
      "default": "⌘["
    }
  },
  "window": {
    "title": "Weather",
    "size": {
      "height": 800
    },
    "minsize": {
      "width": 900,
      "height": 800
    },
    "root": {
      "id": "root",
      "type": "view",
      "layout": "border",
      "events": [
        {
          "triggers": "preload",
          "action": {
            "type": "json",
            "src": {
              "window": {
                "resize": {
                  "width": 1000
                }
              }
            }
          }
        },
        {
          "triggers": "launched",
          "action": [
            {
              "type": "script",
              "src": "../bin/wthr",
              "args": [
                "prepare-origin",
                "{var:weather_session}"
              ],
              "async": false
            },
            {
              "type": "script",
              "src": "../bin/wthr",
              "args": [
                "launch",
                "{var:weather_session}"
              ],
              "async": true
            }
          ]
        }
      ],
      "shortcuts": [
        {
          "shortcut": "↑",
          "action": {
            "type": "function",
            "src": "items",
            "args": "selectprevious"
          }
        },
        {
          "shortcut": "↓",
          "action": {
            "type": "function",
            "src": "items",
            "args": "selectnext"
          }
        },
        {
          "shortcut": "{var:actions_shortcut}",
          "action": {
            "type": "script",
            "src": "../bin/wthr",
            "args": [
              "menu",
              "{var:weather_session}",
              "{value:items.selected.uid}"
            ],
            "async": true
          }
        },
        {
          "shortcut": "⌘R",
          "action": [
            {
              "type": "json",
              "src": {
                "update": {
                  "ids": {
                    "statusLabel": {
                      "text": "Loading weather…",
                      "colour": "secondaryLabelColor"
                    }
                  }
                }
              }
            },
            {
              "type": "script",
              "src": "../bin/wthr",
              "args": [
                "refresh",
                "{var:weather_session}"
              ],
              "async": true
            }
          ]
        }
      ],
      "components": [
        {
          "id": "initialTitle",
          "type": "label",
          "text": "Weather",
          "font": {
            "size": 24,
            "weight": "semibold"
          },
          "constraints": {
            "region": "centre",
            "position": "centre"
          }
        },
        {
          "id": "statusLabel",
          "type": "label",
          "text": "Loading weather…",
          "colour": "secondaryLabelColor",
          "constraints": {
            "region": "top",
            "position": "centre",
            "insets": {
              "top": 24
            }
          }
        },
        {
          "id": "initialBack",
          "type": "button",
          "text": "Back  {var:back_shortcut}",
          "bordered": false,
          "events": [
            {
              "triggers": "actioned",
              "action": {
                "type": "json",
                "src": {
                  "finish": {
                    "variables": {
                      "weather_out": "back",
                      "swiss_return": "{var:swiss_return}"
                    }
                  }
                }
              }
            }
          ],
          "shortcut": "{var:back_shortcut}",
          "constraints": {
            "region": "bottom",
            "position": "left",
            "insets": {
              "left": 16,
              "bottom": 16
            }
          }
        }
      ]
    }
  }
}
