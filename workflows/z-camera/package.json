{
  "name": "alfred-camera",
  "version": "0.1.0",
  "private": true,
  "description": "A quick camera check before a meeting: a small live preview in a corner, toggled from Alfred",
  "author": "izsk",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun scripts/build-workflow.ts",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint tests scripts",
    "fmt": "oxfmt tests scripts",
    "fmt:check": "oxfmt --check tests scripts",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run test",
    "link": "scripts/link.sh",
    "package": "bun run build && scripts/package.sh"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "typescript": "^7.0.2"
  }
}
