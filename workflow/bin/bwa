#!/bin/zsh --no-rcs
# Runs the bundled workflow code with Node. Alfred doesn't load your shell setup,
# so look in the usual install places (or the "Node path" set in the Workflow's Configuration).
here=${0:A:h}
candidates=(
  "$node_path"
  /opt/homebrew/bin/node
  /usr/local/bin/node
  $HOME/.volta/bin/node
  $HOME/.local/bin/node
  $HOME/.nvm/versions/node/*/bin/node(Nn[-1])
  $HOME/.local/share/fnm/node-versions/*/installation/bin/node(Nn[-1])
)
for candidate in $candidates; do
  [[ -n $candidate && -x $candidate ]] && exec "$candidate" "$here/bwa.mjs" "$@"
done
[[ -x $HOME/.bun/bin/bun ]] && exec $HOME/.bun/bin/bun "$here/bwa.mjs" "$@"
print -r -- '{"update":{"ids":{"statusLabel":{"text":"Node.js not found. Set “Node path” in the Workflow’s Configuration.","colour":"systemRedColor"}}}}'
