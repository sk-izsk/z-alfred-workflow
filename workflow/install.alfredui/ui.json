{
  "bundleid": "com.izsk.vscode",
  "log": {
    "level": "error",
    "internal": true
  },
  "variablesconfig": {
    "query": {
      "src": "args[0]",
      "default": ""
    },
    "back_shortcut": {
      "src": "variable",
      "default": "⌘["
    },
    "actions_shortcut": {
      "src": "variable",
      "default": "⌘K"
    },
    "gallery_category": {
      "persist": true,
      "scriptenv": true,
      "default": ""
    }
  },
  "window": {
    "size": {
      "height": 520
    },
    "minsize": {
      "width": 620,
      "height": 360
    },
    "title": "Install Extension",
    "root": {
      "type": "view",
      "layout": "border",
      "events": [
        {
          "triggers": "launched",
          "action": [
            {
              "type": "script",
              "src": "../bin/vsc",
              "args": [
                "gallery-init"
              ]
            },
            {
              "type": "script",
              "src": "../bin/vsc",
              "args": [
                "gallery-pickers"
              ]
            },
            {
              "type": "script",
              "src": "../bin/vsc",
              "args": [
                "gallery-search",
                "{value:searchField.text}",
                "{value:categoryPicker.selected.value}"
              ],
              "async": true
            }
          ]
        },
        {
          "triggers": "preload",
          "action": {
            "type": "json",
            "src": {
              "window": {
                "resize": {
                  "width": 760
                }
              }
            }
          }
        }
      ],
      "shortcuts": [
        {
          "shortcut": "↑",
          "action": {
            "type": "function",
            "src": "items",
            "args": "selectprevious"
          }
        },
        {
          "shortcut": "↓",
          "action": {
            "type": "function",
            "src": "items",
            "args": "selectnext"
          }
        },
        {
          "shortcut": "{var:actions_shortcut}",
          "action": {
            "type": "script",
            "src": "../bin/vsc",
            "args": [
              "gallery",
              "menu",
              "{value:items.selected.uid}"
            ]
          }
        },
        {
          "shortcut": "{var:back_shortcut}",
          "action": {
            "type": "json",
            "src": {
              "finish": {
                "variables": {
                  "vsc_out": "back"
                }
              }
            }
          }
        }
      ],
      "components": [
        {
          "constraints": {
            "region": "top"
          },
          "type": "view",
          "layout": "border",
          "padding": 12,
          "spacing": 8,
          "components": [
            {
              "id": "backButton",
              "type": "button",
              "text": "‹",
              "bordered": false,
              "tooltip": "Back {var:back_shortcut}",
              "font": {
                "size": 26,
                "weight": "light"
              },
              "events": [
                {
                  "triggers": "actioned",
                  "action": {
                    "type": "json",
                    "src": {
                      "finish": {
                        "variables": {
                          "vsc_out": "back"
                        }
                      }
                    }
                  }
                }
              ],
              "constraints": {
                "region": "left",
                "position": "centre",
                "insets": {
                  "left": 2
                }
              }
            },
            {
              "constraints": {
                "region": "centre"
              },
              "id": "searchField",
              "type": "textfield",
              "text": "{var:query}",
              "placeholder": "Search extensions…",
              "focus": true,
              "bordered": false,
              "focusring": false,
              "font": {
                "size": 24,
                "weight": "light"
              },
              "textinsets": {
                "horizontal": 4,
                "vertical": 6
              },
              "events": [
                {
                  "triggers": "typingstopped",
                  "action": {
                    "type": "script",
                    "src": "../bin/vsc",
                    "args": [
                      "gallery-search",
                      "{value:searchField.text}",
                      "{value:categoryPicker.selected.value}"
                    ],
                    "async": true
                  }
                },
                {
                  "triggers": "actioned",
                  "action": [
                    {
                      "type": "json",
                      "src": {
                        "update": {
                          "ids": {
                            "statusLabel": {
                              "text": "Installing…"
                            }
                          }
                        }
                      }
                    },
                    {
                      "type": "script",
                      "src": "../bin/vsc",
                      "args": [
                        "gallery",
                        "install",
                        "{value:items.selected.uid}"
                      ],
                      "async": true
                    }
                  ]
                }
              ]
            },
            {
              "id": "categoryPicker",
              "type": "picker",
              "bordered": false,
              "tooltip": "Category",
              "items": [
                {
                  "text": "All Categories",
                  "value": ""
                }
              ],
              "events": [
                {
                  "triggers": "changed",
                  "action": {
                    "type": "script",
                    "src": "../bin/vsc",
                    "args": [
                      "gallery-search",
                      "{value:searchField.text}",
                      "{value:categoryPicker.selected.value}"
                    ],
                    "async": true
                  }
                }
              ],
              "constraints": {
                "region": "right",
                "position": "centre"
              }
            }
          ]
        },
        {
          "constraints": {
            "region": "centre"
          },
          "type": "view",
          "layout": "border",
          "components": [
            {
              "id": "sectionLabel",
              "type": "label",
              "text": "Found Extensions",
              "colour": "secondaryLabelColor",
              "font": {
                "size": 11.5,
                "weight": "medium"
              },
              "textalign": "left",
              "constraints": {
                "region": "top",
                "stretch": "horizontal",
                "insets": {
                  "left": 20,
                  "top": 2
                }
              }
            },
            {
              "constraints": {
                "region": "centre"
              },
              "id": "items",
              "type": "dataview",
              "padding": 6,
              "spacing": 2,
              "placeholder": "Type to search, or pick a category",
              "behaviour": {
                "selection": {
                  "wrap": "none"
                }
              },
              "data": {
                "type": "basic",
                "src": []
              },
              "cell": {
                "height": 38,
                "init": {
                  "rowCell.background": null,
                  "rowTitle.colour": "labelColor",
                  "rowDetail.colour": "secondaryLabelColor",
                  "rowInstalls.colour": "secondaryLabelColor",
                  "rowVersion.colour": "secondaryLabelColor",
                  "rowIcon.contenttintcolour": "secondaryLabelColor",
                  "rowDownload.contenttintcolour": "secondaryLabelColor"
                },
                "selected": {
                  "rowCell.background": "alfredSelectedResultBackgroundColor",
                  "rowTitle.colour": "alfredSelectedResultTextColor",
                  "rowDetail.colour": "alfredSelectedResultTextColor",
                  "rowInstalls.colour": "alfredSelectedResultTextColor",
                  "rowVersion.colour": "alfredSelectedResultTextColor",
                  "rowIcon.contenttintcolour": "alfredSelectedResultTextColor",
                  "rowDownload.contenttintcolour": "alfredSelectedResultTextColor"
                },
                "root": {
                  "id": "rowCell",
                  "type": "view",
                  "layout": "border",
                  "padding": 6,
                  "spacing": 10,
                  "cornerradius": 8,
                  "events": [
                    {
                      "triggers": "doubleclicked",
                      "action": {
                        "type": "script",
                        "src": "../bin/vsc",
                        "args": [
                          "gallery",
                          "install",
                          "{data:uid}"
                        ]
                      }
                    }
                  ],
                  "components": [
                    {
                      "id": "rowIcon",
                      "type": "imageview",
                      "resize": "fit",
                      "image": {
                        "type": "symbol",
                        "src": "folder",
                        "size": {
                          "height": 20
                        }
                      },
                      "constraints": {
                        "region": "left",
                        "position": "centre",
                        "size": {
                          "width": 24,
                          "height": 24
                        },
                        "insets": {
                          "left": 4
                        }
                      }
                    },
                    {
                      "constraints": {
                        "region": "centre",
                        "stretch": "horizontal"
                      },
                      "type": "view",
                      "layout": "border",
                      "spacing": 8,
                      "components": [
                        {
                          "id": "rowTitle",
                          "type": "label",
                          "text": "",
                          "font": {
                            "size": 14,
                            "weight": "medium"
                          },
                          "constraints": {
                            "position": "centre",
                            "region": "left"
                          }
                        },
                        {
                          "id": "rowDetail",
                          "type": "label",
                          "text": "",
                          "colour": "secondaryLabelColor",
                          "font": {
                            "size": 13
                          },
                          "textalign": "left",
                          "constraints": {
                            "position": "centre",
                            "region": "centre",
                            "stretch": "horizontal"
                          }
                        }
                      ]
                    },
                    {
                      "constraints": {
                        "region": "right",
                        "position": "centre",
                        "insets": {
                          "right": 4
                        }
                      },
                      "type": "view",
                      "layout": "inline",
                      "spacing": 8,
                      "components": [
                        {
                          "id": "rowInstalledPill",
                          "type": "view",
                          "layout": "inline",
                          "spacing": 4,
                          "padding": 3,
                          "cornerradius": 5,
                          "background": "#0a84ff26",
                          "components": [
                            {
                              "id": "rowInstalled",
                              "type": "label",
                              "text": "Installed",
                              "colour": "systemBlueColor",
                              "font": {
                                "size": 11.5,
                                "weight": "medium"
                              },
                              "constraints": {
                                "position": "centre"
                              }
                            }
                          ],
                          "constraints": {
                            "position": "centre"
                          }
                        },
                        {
                          "id": "rowDownload",
                          "type": "imageview",
                          "image": {
                            "type": "symbol",
                            "src": "arrow.down.to.line",
                            "size": {
                              "height": 11
                            }
                          },
                          "contenttintcolour": "secondaryLabelColor",
                          "constraints": {
                            "position": "centre"
                          }
                        },
                        {
                          "id": "rowInstalls",
                          "type": "label",
                          "text": "",
                          "colour": "secondaryLabelColor",
                          "font": {
                            "size": 12
                          },
                          "constraints": {
                            "position": "centre"
                          }
                        },
                        {
                          "id": "rowVersionPill",
                          "type": "view",
                          "layout": "inline",
                          "spacing": 4,
                          "padding": 3,
                          "cornerradius": 5,
                          "background": "#8080801f",
                          "components": [
                            {
                              "id": "rowVersion",
                              "type": "label",
                              "text": "",
                              "colour": "secondaryLabelColor",
                              "font": {
                                "size": 11.5,
                                "monospaced": "digits"
                              },
                              "constraints": {
                                "position": "centre"
                              }
                            }
                          ],
                          "constraints": {
                            "position": "centre"
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "constraints": {
            "region": "bottom"
          },
          "type": "view",
          "layout": "border",
          "padding": 10,
          "background": {
            "dark": "#00000033",
            "light": "#0000000d"
          },
          "components": [
            {
              "constraints": {
                "region": "left",
                "insets": {
                  "left": 6
                }
              },
              "type": "view",
              "layout": "inline",
              "spacing": 8,
              "components": [
                {
                  "type": "imageview",
                  "image": {
                    "type": "file",
                    "src": "../icon.png",
                    "size": {
                      "width": 18,
                      "height": 18
                    }
                  },
                  "constraints": {
                    "position": "centre"
                  }
                },
                {
                  "id": "statusLabel",
                  "type": "label",
                  "text": "…",
                  "colour": "secondaryLabelColor",
                  "font": {
                    "size": 12.5
                  },
                  "constraints": {
                    "position": "centre",
                    "size": {
                      "width": 300
                    }
                  }
                }
              ]
            },
            {
              "constraints": {
                "region": "right",
                "insets": {
                  "right": 6
                }
              },
              "type": "view",
              "layout": "inline",
              "spacing": 10,
              "components": [
                {
                  "id": "primaryButton",
                  "type": "button",
                  "text": "Install Extension  ↩",
                  "bordered": false,
                  "font": {
                    "size": 12.5,
                    "weight": "medium"
                  },
                  "events": [
                    {
                      "triggers": "actioned",
                      "action": [
                        {
                          "type": "json",
                          "src": {
                            "update": {
                              "ids": {
                                "statusLabel": {
                                  "text": "Installing…"
                                }
                              }
                            }
                          }
                        },
                        {
                          "type": "script",
                          "src": "../bin/vsc",
                          "args": [
                            "gallery",
                            "install",
                            "{value:items.selected.uid}"
                          ],
                          "async": true
                        }
                      ]
                    }
                  ],
                  "constraints": {
                    "position": "centre"
                  }
                },
                {
                  "type": "view",
                  "background": "separatorColor",
                  "constraints": {
                    "position": "centre",
                    "size": {
                      "width": 1,
                      "height": 14
                    }
                  }
                },
                {
                  "id": "actionsButton",
                  "type": "button",
                  "text": "Actions  {var:actions_shortcut}",
                  "bordered": false,
                  "font": {
                    "size": 12.5,
                    "weight": "medium"
                  },
                  "events": [
                    {
                      "triggers": "actioned",
                      "action": {
                        "type": "script",
                        "src": "../bin/vsc",
                        "args": [
                          "gallery",
                          "menu",
                          "{value:items.selected.uid}"
                        ]
                      }
                    }
                  ],
                  "constraints": {
                    "position": "centre"
                  }
                },
                {
                  "id": "previewKey",
                  "type": "button",
                  "text": "",
                  "bordered": false,
                  "font": {
                    "size": 12.5,
                    "weight": "medium"
                  },
                  "events": [
                    {
                      "triggers": "actioned",
                      "action": {
                        "type": "script",
                        "src": "../bin/vsc",
                        "args": [
                          "gallery",
                          "preview",
                          "{value:items.selected.uid}"
                        ]
                      }
                    }
                  ],
                  "shortcut": "⌘Y",
                  "opacity": 0,
                  "constraints": {
                    "position": "centre",
                    "size": {
                      "width": 0,
                      "height": 0
                    }
                  }
                },
                {
                  "id": "browserKey",
                  "type": "button",
                  "text": "",
                  "bordered": false,
                  "font": {
                    "size": 12.5,
                    "weight": "medium"
                  },
                  "events": [
                    {
                      "triggers": "actioned",
                      "action": {
                        "type": "script",
                        "src": "../bin/vsc",
                        "args": [
                          "gallery",
                          "browser",
                          "{value:items.selected.uid}"
                        ]
                      }
                    }
                  ],
                  "shortcut": "⇧⌘O",
                  "opacity": 0,
                  "constraints": {
                    "position": "centre",
                    "size": {
                      "width": 0,
                      "height": 0
                    }
                  }
                },
                {
                  "id": "copyIdKey",
                  "type": "button",
                  "text": "",
                  "bordered": false,
                  "font": {
                    "size": 12.5,
                    "weight": "medium"
                  },
                  "events": [
                    {
                      "triggers": "actioned",
                      "action": {
                        "type": "script",
                        "src": "../bin/vsc",
                        "args": [
                          "gallery",
                          "copy-id",
                          "{value:items.selected.uid}"
                        ]
                      }
                    }
                  ],
                  "shortcut": "⇧⌘C",
                  "opacity": 0,
                  "constraints": {
                    "position": "centre",
                    "size": {
                      "width": 0,
                      "height": 0
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
